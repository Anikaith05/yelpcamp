<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>YelpCamp</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(135deg, #f8f9fa 0%, #eef3ff 100%);
      min-height: 100vh;
      font-family: Arial, sans-serif;
    }

    .navbar-brand {
      font-weight: 700;
      letter-spacing: 0.03em;
    }

    .hero-card {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(13, 110, 253, 0.08);
      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    .hero-card h1 {
      font-size: clamp(2.2rem, 4vw, 4rem);
      font-weight: 800;
    }

    .feature-badge {
      display: inline-block;
      background: rgba(13, 110, 253, 0.1);
      color: #0d6efd;
      font-size: 0.8rem;
      letter-spacing: 0.08em;
      border-radius: 999px;
      padding: 0.45rem 0.9rem;
      text-transform: uppercase;
      font-weight: 700;
    }

    .hero-illustration {
      background: linear-gradient(135deg, #0d6efd 0%, #6f42c1 100%);
      min-height: 320px;
      border-radius: 1.5rem;
      position: relative;
      overflow: hidden;
    }

    .hero-illustration::before,
    .hero-illustration::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.2);
    }

    .hero-illustration::before {
      width: 210px;
      height: 210px;
      right: -30px;
      top: -40px;
    }

    .hero-illustration::after {
      width: 170px;
      height: 170px;
      left: -20px;
      bottom: -30px;
    }

    .hero-content {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 100%;
      padding: 2rem;
      color: white;
    }

    .hero-content .mini-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      opacity: 0.85;
    }

    .hero-content h2 {
      font-weight: 700;
      margin-top: 0.5rem;
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/">YelpCamp</a>
      <div class="ms-auto">
        <a class="btn btn-outline-light" href="/campgrounds">View Campgrounds</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="hero-card rounded-4 p-4 p-lg-5">
      <div class="row align-items-center g-4">
        <div class="col-lg-7">
          <span class="feature-badge">Explore nature</span>
          <h1 class="mt-3 mb-3">Find your next campground adventure</h1>
          <p class="lead text-muted mb-4">
            Explore scenic camping spots, plan your next outdoor getaway, and share unforgettable places with fellow travelers.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a class="btn btn-primary btn-lg" href="/campgrounds">View Campgrounds</a>
            <a class="btn btn-outline-primary btn-lg" href="/campgrounds/new">Create a New Campground</a>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="hero-illustration">
            <div class="hero-content">
              <span class="mini-label">Top picks</span>
              <h2>Mountain escapes</h2>
              <p class="mb-0">Fresh air, wide views, and unforgettable nights beneath the stars.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>
