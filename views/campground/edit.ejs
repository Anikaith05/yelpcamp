<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Edit Campground</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(135deg, #f8f9fa 0%, #eef3ff 100%);
      min-height: 100vh;
      font-family: Arial, sans-serif;
    }

    .card {
      border-radius: 1.25rem;
      border: none;
      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    .form-control,
    .form-control:focus {
      border-radius: 0.75rem;
      border-color: #d0d7de;
      box-shadow: none;
    }

    .form-control:focus {
      border-color: #86b7fe;
    }

    label {
      font-weight: 600;
      margin-bottom: 0.5rem;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/">YelpCamp</a>
      <div class="ms-auto">
        <a class="btn btn-outline-light" href="/campgrounds/<%= camp._id %>">Back to Campground</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="card">
          <div class="card-body p-4 p-lg-5">
            <h1 class="mb-4">Edit Campground</h1>
            <form action="/campgrounds/<%= camp._id %>?_method=PUT" method="POST" class="row g-3">
              <div class="col-12">
                <label for="title">Title</label>
                <input id="title" class="form-control" type="text" name="title" value="<%= camp.title %>" required>
              </div>

              <div class="col-md-6">
                <label for="location">Location</label>
                <input id="location" class="form-control" type="text" name="location" value="<%= camp.location %>" required>
              </div>

              <div class="col-md-6">
                <label for="price">Price</label>
                <input id="price" class="form-control" type="number" name="price" value="<%= camp.price %>" min="0" step="0.01" required>
              </div>

              <div class="col-12">
                <label for="description">Description</label>
                <textarea id="description" class="form-control" name="description" rows="5" required><%= camp.description %></textarea>
              </div>

              <div class="col-12 d-flex gap-3 flex-wrap">
                <button type="submit" class="btn btn-primary btn-lg">Update Campground</button>
                <a href="/campgrounds/<%= camp._id %>" class="btn btn-outline-secondary btn-lg">Cancel</a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>
</body>
</html>