<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Campgrounds</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(135deg, #f8f9fa 0%, #eef2ff 100%);
      min-height: 100vh;
      font-family: Arial, sans-serif;
    }

    .card {
      border-radius: 1.1rem;
      overflow: hidden;
      border: none;
      box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);
    }

    .camp-image {
      height: 220px;
      object-fit: cover;
    }

    .camp-card-title {
      font-weight: 700;
      margin-bottom: 0.35rem;
    }

    .camp-card-body {
      padding: 1.2rem 1.2rem 1rem;
    }

    .camp-card-footer {
      padding: 0 1.2rem 1.2rem;
      background-color: white;
    }

    .text-muted-sm {
      color: #6c757d;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/">YelpCamp</a>
      <div class="ms-auto">
        <a class="btn btn-outline-light" href="/campgrounds/new">Add Campground</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
      <div>
        <p class="text-uppercase text-primary fw-bold mb-1">Discover</p>
        <h1 class="mb-0">Campgrounds</h1>
      </div>
      <a class="btn btn-primary btn-lg" href="/campgrounds/new">Create New Campground</a>
    </div>

    <div class="row g-4">
      <% for (let camp of campgrounds) { %>
        <div class="col-md-6 col-xl-4">
          <div class="card h-100">
            <img class="camp-image" src="<%= camp.image %>" alt="<%= camp.title %>">
            <div class="camp-card-body">
              <h5 class="camp-card-title"><%= camp.title %></h5>
              <p class="text-muted-sm mb-2"><%= camp.location %></p>
              <p class="mb-0 text-secondary">
                <%= camp.description.slice(0, 100) %>...
              </p>
            </div>
            <div class="camp-card-footer">
              <a class="btn btn-outline-primary w-100" href="/campgrounds/<%= camp._id %>">View Campground</a>
            </div>
          </div>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>