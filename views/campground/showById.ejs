<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= camp.title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body {
      background: linear-gradient(135deg, #f8f9fa 0%, #edf4ff 100%);
      min-height: 100vh;
      font-family: Arial, sans-serif;
    }

    .detail-card {
      border: none;
      border-radius: 1.5rem;
      overflow: hidden;
      box-shadow: 0 18px 45px rgba(15, 23, 42, 0.08);
    }

    .detail-image {
      width: 100%;
      height: 500px;
      object-fit: cover;
    }

    .page-badge {
      background: rgba(13, 110, 253, 0.1);
      color: #0d6efd;
      padding: 0.45rem 0.8rem;
      border-radius: 999px;
      font-weight: 700;
      font-size: 0.85rem;
    }

    .action-row {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin-top: 2rem;
    }

    .reviews-section {
      margin-top: 3rem;
    }

    .review-form,
    .review-card {
      background: rgba(255, 255, 255, 0.9);
      border: 1px solid rgba(13, 110, 253, 0.1);
      border-radius: 1rem;
      box-shadow: 0 10px 25px rgba(15, 23, 42, 0.06);
    }

    .review-form {
      padding: 1.5rem;
    }

    .review-form .form-label {
      color: #344054;
      font-weight: 600;
    }

    .rating-value {
      color: #0d6efd;
      font-weight: 700;
    }

    .review-card {
      height: 100%;
      padding: 1.25rem;
    }

    .review-rating {
      color: #b7791f;
      font-weight: 700;
    }

    .review-body {
      color: #475467;
      min-height: 3rem;
    }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
      <a class="navbar-brand" href="/">YelpCamp</a>
      <div class="ms-auto">
        <a class="btn btn-outline-light" href="/campgrounds">All Campgrounds</a>
      </div>
    </div>
  </nav>

  <main class="container py-5">
    <div class="card detail-card">
      <img class="detail-image" src="<%= camp.image %>" alt="<%= camp.title %>">
      <div class="card-body p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
          <div>
            <h1 class="mb-2"><%= camp.title %></h1>
            <p class="text-muted mb-0"><%= camp.location %></p>
          </div>
          <span class="page-badge">$<%= camp.price %> / night</span>
        </div>

        <p class="lead mt-4 mb-0"><%= camp.description %></p>

        <div class="action-row">
          <a class="btn btn-warning btn-lg" href="/campgrounds/<%= camp._id %>/edit">Edit Campground</a>
          <form action="/campgrounds/<%= camp._id %>?_method=DELETE" method="POST" class="d-inline">
            <button type="submit" class="btn btn-danger btn-lg">Delete</button>
          </form>
          <a class="btn btn-outline-secondary btn-lg" href="/campgrounds">Back to List</a>
        </div>
      </div>
    </div>
    <section class="reviews-section">
      <div class="d-flex align-items-center gap-2 mb-3">
        <span class="text-primary fs-4">*</span>
        <h2 class="h3 mb-0">Add a review</h2>
      </div>

      <div class="review-form">
      <form action="/campgrounds/<%=camp._id%>/review" method="POST">
        <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center mb-2">
          <label class="form-label mb-0" for="rating">Rating</label>
          <span class="rating-value">1 to 5 stars</span>
        </div>
        <input class="form-range" type="range" min="1" max="5" value="3" name="rating" id="rating">
        </div>

        <div class="mb-3">
        <label class="form-label" for="body">Description</label>
        <textarea class="form-control" name="body" id="body" rows="4" placeholder="Share what made this campground memorable..."></textarea>
        </div>
        <button class="btn btn-primary px-4" type="submit">Add review</button>
      </form>
      </div>

      <div class="d-flex align-items-center justify-content-between mt-5 mb-3">
        <h2 class="h3 mb-0">Guest reviews</h2>
        <span class="badge text-bg-light border"><%= camp.reviews.length %> review<%= camp.reviews.length === 1 ? '' : 's' %></span>
      </div>

      <div class="row g-3">
      <%for(let review of camp.reviews){%>
        <div class="col-md-6">
          <article class="review-card d-flex flex-column">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="review-rating">★ <%=review.rating%> / 5</span>
              <form action="/campgrounds/<%=camp._id%>/review/<%=review._id%>?_method=DELETE" method="POST">
                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
              </form>
            </div>
            <p class="review-body mb-0"><%=review.body%></p>
          </article>
        </div>
      <%}%>
      </div>
    </section>
  </main>
</body>
</html>